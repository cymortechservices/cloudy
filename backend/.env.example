# --- Server ---
PORT=8080
NODE_ENV=development
# Exact production frontend origin (CORS allowlist), no trailing slash
FRONTEND_URL=http://localhost:5173
# --- Supabase (Project Settings > API) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Server-only privileged key. NEVER expose to the browser.
SUPABASE_SECRET_KEY=
# --- Storage ---
# supabase (default, no card needed) or r2
STORAGE_PROVIDER=supabase
# Private bucket created by migration 0002
SUPABASE_STORAGE_BUCKET=cloudy-private
# Only needed when STORAGE_PROVIDER=r2:
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# --- Limits (Supabase free plan has ~1 GB total storage: verify) ---
MAX_FILE_SIZE_BYTES=26214400
# 900 MB across all users
GLOBAL_STORAGE_CAP_BYTES=943718400
UPLOAD_RESERVATION_TTL_SECONDS=900
