# --- Server ---
PORT=8080
NODE_ENV=development
# Production frontend origin (CORS allowlist). Vercel URL once deployed.
FRONTEND_URL=http://localhost:5173
# --- Supabase (Project Settings > API) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Server-only privileged key. NEVER expose to the browser.
SUPABASE_SECRET_KEY=
# --- Storage ---
STORAGE_PROVIDER=r2
# Cloudflare R2: dashboard > R2 > Manage API tokens (Object Read & Write, scoped to the bucket)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=cloudy-private
# --- Limits ---
MAX_FILE_SIZE_BYTES=26214400
DEFAULT_USER_QUOTA_BYTES=1073741824
# Keep below your provider's free allowance (R2 free tier is 10 GB-month; verify current terms)
GLOBAL_STORAGE_CAP_BYTES=8589934592
UPLOAD_RESERVATION_TTL_SECONDS=900
